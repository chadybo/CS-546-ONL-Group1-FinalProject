<div style="max-width:600px;margin:0 auto">
  <div class="page-header">
    <h1>Submit a Complaint</h1>
    <p>Report a noise issue in your neighborhood.</p>
  </div>

  {{#if error}}
    <div class="alert alert-error">{{error}}</div>
  {{/if}}

  <div class="card">
    <form method="POST" action="/complaints/submit" data-validate-form novalidate>
      <div class="alert alert-error form-error-summary" role="alert" aria-live="assertive" hidden></div>
      <div class="form-group">
        <label for="address">Address</label>
        <input id="address" type="text" name="address" placeholder="e.g. 251 W 30th St" minlength="5" maxlength="120" autocomplete="address-line1" data-validate="address" aria-describedby="address-error" required />
        <span id="address-error" class="field-error" aria-live="polite"></span>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="borough">Borough</label>
          <select id="borough" name="borough" data-validate aria-describedby="borough-error" required>
            <option value="">Select a borough</option>
            {{#each boroughs}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
          <span id="borough-error" class="field-error" aria-live="polite"></span>
        </div>
        <div class="form-group">
          <label for="complaintType">Complaint Type</label>
          <select id="complaintType" name="complaintType" data-validate aria-describedby="type-error" required>
            <option value="">Select a type</option>
            {{#each types}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
          <span id="type-error" class="field-error" aria-live="polite"></span>
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description <span style="color:#adb5bd;font-weight:400">(optional)</span></label>
        <textarea id="description" name="description" maxlength="500" data-validate="description" aria-describedby="description-count description-error" placeholder="Describe the issue in more detail..."></textarea>
        <span id="description-count" class="char-count" aria-live="polite"></span>
        <span id="description-error" class="field-error" aria-live="polite"></span>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%" data-submitting-text="Submitting…">Submit Complaint</button>
    </form>
  </div>
</div>
