<div class="page-header">
  <h1>Welcome, {{username}}</h1>
  <p>Track your submitted complaints and bookmarks.</p>
</div>

<div style="display:flex;gap:12px;margin-bottom:32px">
  <a href="/complaints/submit" class="btn btn-primary">Submit a complaint</a>
</div>

<div class="page-header">
  <h1 style="font-size:20px">Your Complaints</h1>
</div>

{{#if submittedComplaints.length}}
  <div class="table-wrap" style="margin-bottom:40px">
    <table>
      <thead>
        <tr>
          <th>Type</th>
          <th>Address</th>
          <th>Borough</th>
          <th>Date</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each submittedComplaints}}
          <tr>
            <td style="font-weight:500">{{this.complaintType}}</td>
            <td style="color:#495057">{{this.incidentAddress}}</td>
            <td>{{this.borough}}</td>
            <td style="color:#adb5bd;font-size:13px">{{this.createdDate}}</td>
            <td>
              {{#if (eq this.status 'open')}}
                <span class="badge badge-open">Open</span>
              {{else if (eq this.status 'resolved')}}
                <span class="badge badge-resolved">Resolved</span>
              {{else}}
                <span class="badge badge-open">{{this.status}}</span>
              {{/if}}
            </td>
            <td>
              <a href="/complaints/{{this._id}}" class="btn btn-outline btn-sm">View</a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="empty-state" style="margin-bottom:40px">
    <p>You have not submitted any complaints yet.</p>
    <a href="/complaints/submit" class="btn btn-outline">Submit your first complaint</a>
  </div>
{{/if}}

<div class="page-header">
  <h1 style="font-size:20px">Bookmarks</h1>
</div>

{{#if bookmarks.length}}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Type</th>
          <th>Address</th>
          <th>Borough</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each bookmarks}}
          <tr>
            <td style="font-weight:500">{{this.complaintType}}</td>
            <td style="color:#495057">{{this.incidentAddress}}</td>
            <td>{{this.borough}}</td>
            <td>
              {{#if (eq this.status 'open')}}
                <span class="badge badge-open">Open</span>
              {{else if (eq this.status 'resolved')}}
                <span class="badge badge-resolved">Resolved</span>
              {{else}}
                <span class="badge badge-open">{{this.status}}</span>
              {{/if}}
            </td>
            <td>
              <a href="/complaints/{{this._id}}" class="btn btn-outline btn-sm">View</a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="empty-state">
    <p>You have no bookmarked complaints yet.</p>
    <a href="/complaints/browse" class="btn btn-outline">Browse complaints</a>
  </div>
{{/if}}