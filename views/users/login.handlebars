<div class="auth-wrap">
  <h1>Welcome back</h1>
  <div id="loginError" class="alert alert-error" style="display:none;"></div>
  <div class="card">
    <form id="loginForm" novalidate>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" required />
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="password" name="password" placeholder="Your password" required />
      </div>
      <button type="submit" id="loginBtn" class="btn btn-primary" style="width:100%">Log In</button>
    </form>
  </div>
  <p class="auth-footer">Don't have an account? <a href="/users/register">Register here</a></p>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
  $('#loginForm').on('submit', function (e) {
    e.preventDefault();

    const $btn = $('#loginBtn');
    const $error = $('#loginError');

    $error.hide().text('');
    $btn.prop('disabled', true).text('Logging in...');

    $.ajax({
      url: '/users/login',
      method: 'POST',
      data: {
        email: $('#email').val(),
        password: $('#password').val()
      },
      success: function (res) {
        window.location.href = res.redirect || '/users/dashboard';
      },
      error: function (xhr) {
        const message =
          (xhr.responseJSON && xhr.responseJSON.error) || 'Login failed';
        $error.text(message).show();
        $btn.prop('disabled', false).text('Log In');
      }
    });
  });
</script>
