<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}} | Street Noise NYC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/public/css/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-inner">
        <a href="/" class="nav-brand">Street Noise NYC</a>
        <div class="nav-links">
          <a href="/complaints/browse" class="nav-link">Browse</a>
          <a href="/complaints/hotspots" class="nav-link">Hotspots</a>
          <a href="/complaints/address" class="nav-link">Address History</a>
          <div class="nav-dropdown">
            <a href="#" class="nav-link nav-dropdown-toggle">
              Trends
              <span class="dropdown-symbol">▾</span>
            </a>
            <div class="nav-dropdown-menu">
              <a href="/complaints/trends" class="nav-dropdown-link">Complaints
                Over Time</a>
              <a href="/complaints/common" class="nav-dropdown-link">Common
                Complaints</a>
            </div>
          </div>
          {{#if user}}
            <a href="/users/dashboard" class="nav-link">Dashboard</a>
            {{#if (eq user.role "admin")}}<a
                href="/admin"
                class="nav-link"
              >Admin</a>{{/if}}
            <form method="POST" action="/users/logout" class="nav-logout-form">
              <button
                type="submit"
                class="nav-link nav-link-button"
              >Logout</button>
            </form>
          {{else}}
            <a href="/users/login" class="nav-link">Login</a>
            <a href="/users/register" class="nav-btn">Register</a>
          {{/if}}
        </div>
      </div>
    </nav>
    {{#if successMessage}}<div
        class="alert alert-success"
      >{{successMessage}}</div>{{/if}}
    {{#if errorMessage}}<div
        class="alert alert-error"
      >{{errorMessage}}</div>{{/if}}
    <main class="main-content">
      {{{body}}}
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <span>Street Noise NYC</span>
        <span>Data from NYC Open Data 311</span>
      </div>
    </footer>
    <script type="module" src="/public/js/client-validation.js"></script>
  </body>
</html>