<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{seo.title}}</title>
    <meta name="description" content="{{seo.description}}" />
    <meta name="robots" content="{{seo.robots}}" />
    {{#if seo.canonicalUrl}}
      <link rel="canonical" href="{{seo.canonicalUrl}}" />
    {{/if}}

    <meta property="og:type" content="{{seo.ogType}}" />
    <meta property="og:site_name" content="{{seo.siteName}}" />
    <meta property="og:title" content="{{seo.ogTitle}}" />
    <meta property="og:description" content="{{seo.ogDescription}}" />
    {{#if seo.ogUrl}}
      <meta property="og:url" content="{{seo.ogUrl}}" />
    {{/if}}
    {{#if seo.socialImageUrl}}
      <meta property="og:image" content="{{seo.socialImageUrl}}" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="{{seo.socialImageAlt}}" />
    {{/if}}

    <meta name="twitter:card" content="{{seo.twitterCard}}" />
    <meta name="twitter:title" content="{{seo.ogTitle}}" />
    <meta name="twitter:description" content="{{seo.ogDescription}}" />
    {{#if seo.socialImageUrl}}
      <meta name="twitter:image" content="{{seo.socialImageUrl}}" />
      <meta name="twitter:image:alt" content="{{seo.socialImageAlt}}" />
    {{/if}}

    {{#if seo.faviconUrl}}
      <link rel="icon" href="{{seo.faviconUrl}}" type="image/svg+xml" />
    {{/if}}
    {{#if seo.appleTouchIconUrl}}
      <link rel="apple-touch-icon" href="{{seo.appleTouchIconUrl}}" />
    {{/if}}

    {{#if seo.jsonLd}}
      <script type="application/ld+json">{{{seo.jsonLd}}}</script>
    {{/if}}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/public/css/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-inner">
        <a href="/" class="nav-brand">Street Noise NYC</a>
        <div class="nav-links">
          <a href="/complaints/browse" class="nav-link">Browse</a>
          <a href="/complaints/hotspots" class="nav-link">Hotspots</a>
          <a href="/complaints/address" class="nav-link">Address History</a>
          <div class="nav-dropdown">
            <a href="#" class="nav-link nav-dropdown-toggle">
              Trends
              <span class="dropdown-symbol">▾</span>
            </a>
            <div class="nav-dropdown-menu">
              <a href="/complaints/trends" class="nav-dropdown-link">Complaints
                Over Time</a>
              <a href="/complaints/common" class="nav-dropdown-link">Common
                Complaints</a>
            </div>
          </div>
          {{#if user}}
            <a href="/users/dashboard" class="nav-link">Dashboard</a>
            <a href="/users/logout" class="nav-link">Logout</a>
          {{else}}
            <a href="/users/login" class="nav-link">Login</a>
            <a href="/users/register" class="nav-btn">Register</a>
          {{/if}}
        </div>
      </div>
    </nav>
    <main class="main-content">
      {{{body}}}
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <span>Street Noise NYC</span>
        <span>Data from NYC Open Data 311</span>
      </div>
    </footer>
  </body>
</html>
